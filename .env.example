# Copiar a .env y completar. Lo lee docker compose.

# Dirección con la que el navegador abre la app: localhost en local, la IP de la VM en el servidor.
HOST=localhost

# Contraseña de PostgreSQL.
DB_PASSWORD=

# Clave para firmar los JWT: 32 caracteres o más (por ejemplo, la salida de `openssl rand -base64 32`).
JWT_SECRET=
